# ====================================================================
# CertiVault Marketplace - Environment Configuration
# ====================================================================

# Database & Supabase (PostgreSQL with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# (Optional alias: NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Payment Gateway (Test or Live Mode)
# Important: Key ID and Key Secret must belong to the same Razorpay account.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend Transactional Email API
RESEND_API_KEY=re_your_resend_api_key

# Admin & Internal Security
ADMIN_SECRET_KEY=certivault_admin_sec_9918239012481
