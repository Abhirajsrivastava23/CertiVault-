# CertiVault Environment Configuration

# Next.js Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Keys (Required for Auth & Public RLS Queries)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Used strictly server-side for secure voucher allocation & webhook updates)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Razorpay Payment Integration (India Gateway: UPI, Cards, Net Banking)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# Resend Email Delivery
RESEND_API_KEY="re_123456789"
EMAIL_FROM="CertiVault Orders <orders@certivault.in>"

# Admin API Key (For protected server-side inventory CSV import)
ADMIN_API_KEY="cv_admin_supersecret_key_2026"
